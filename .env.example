# Sanitized host-development example. Docker stack helpers generate their own inputs.
APP_ENV=development
NODE_ENV=development
PORT=8080
# Run npm run build:native before native startup; build facts come from .build/.
IDENTITY_PROJECT_ID=demo-blogpost-local
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
MEDIA_ADAPTER=local
MEDIA_LOCAL_ROOT=.local/media
API_ORIGIN=http://localhost:8080
WEB_ORIGIN=http://localhost:3000
SQL_HOST=127.0.0.1
SQL_PORT=5432
SQL_DATABASE=blogpost
SQL_APP_PASSWORD=replace-with-generated-local-password
CURSOR_SIGNING_KEY=replace-with-a-separate-random-64-character-lowercase-hex-key
# Jobs only. Never supply root or migration credentials to the API.
SQL_MIGRATOR_PASSWORD=replace-with-generated-local-password
SQL_ROOT_USER=postgres
SQL_ROOT_PASSWORD=replace-with-generated-local-password
