{
  "name": "blogpost-backend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.22.1 <25",
    "npm": ">=11 <12"
  },
  "packageManager": "npm@11.19.1",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:prepare": "node scripts/build/prepare.mjs",
    "build:native": "node scripts/build/native.mjs",
    "build:image": "node scripts/build/image.mjs",
    "test:build": "node --test test/build/*.test.mjs",
    "test:build-images": "node scripts/dev/test-build-images.mjs",
    "test:deploy": "node --test test/deploy/*.test.mjs",
    "deploy:verify-config": "node scripts/deploy/verify-config.mjs",
    "start": "node dist/main.js",
    "start:dev": "tsx watch src/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/unit/*.test.ts test/contract/*.test.ts test/mock/*.test.ts",
    "test:mock": "tsx --test test/mock/*.test.ts",
    "mock": "node scripts/dev/mock.mjs",
    "mock:smoke": "node scripts/dev/mock.mjs --smoke",
    "test:integration": "tsx --test --test-concurrency=1 test/integration/*.test.ts",
    "test:identity": "node scripts/dev/test-identity.mjs",
    "test:recovery": "node scripts/dev/test-recovery.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:bootstrap": "tsx src/ops/bootstrap-db.ts",
    "db:bootstrap-admin": "tsx src/ops/bootstrap-admin.ts",
    "db:migrate": "tsx src/ops/migrate.ts",
    "db:verify": "tsx src/ops/verify-db.ts",
    "db:maintenance": "tsx src/ops/maintenance.ts",
    "dev:stack": "node scripts/dev/stack.mjs",
    "contract:manifest": "node scripts/contract-manifest.mjs",
    "contract:build": "node scripts/build-contract.mjs",
    "contract:typescript": "node scripts/generate-typescript.mjs",
    "contract:kotlin": "node scripts/generate-kotlin.mjs",
    "contract:kotlin:test": "node scripts/test-kotlin.mjs",
    "contract:tools": "node scripts/install-oasdiff.mjs",
    "contract:compatibility": "node scripts/contract-compatibility.mjs",
    "contract:compatibility:test": "node scripts/test-compatibility.mjs",
    "contract:conformance": "tsx test/conformance/probe.ts",
    "contract:conformance:full": "node test/conformance/isolated.mjs",
    "contract:package": "node scripts/contract-package.mjs",
    "contract:package:verify": "node scripts/contract-package.mjs --verify",
    "docker:space": "docker system df",
    "docker:cache": "docker buildx prune --force --filter type!=exec.cachemount --max-used-space 256MB --reserved-space 64MB",
    "test:ci": "node --test test/ci/*.test.mjs",
    "security:check": "node scripts/ci/security.mjs",
    "security:test": "node scripts/ci/test-security.mjs",
    "docs:check": "node scripts/ci/docs.mjs --all"
  },
  "dependencies": {
    "@fastify/busboy": "3.2.4",
    "@nestjs/common": "12.2.0",
    "@nestjs/core": "12.2.0",
    "@nestjs/platform-express": "12.2.0",
    "@nestjs/swagger": "12.0.4",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "dotenv": "18.0.9",
    "firebase-admin": "14.5.0",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "rxjs": "7.8.2",
    "semver": "7.8.5",
    "sharp": "0.35.5",
    "unified": "11.0.5"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "13.1.0",
    "@types/express": "5.0.6",
    "@types/mdast": "4.0.4",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/semver": "7.8.0",
    "@types/supertest": "7.2.1",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "fastify": "5.12.7",
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.10",
    "prisma": "7.10.1",
    "supertest": "7.3.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "yaml": "2.9.1"
  },
  "overrides": {
    "multer": "2.5.0"
  }
}
