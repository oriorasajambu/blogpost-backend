{
  "schemaVersion": 1,
  "environment": "staging",
  "projectId": "blogpost-staging",
  "apiOrigin": "https://goblog-api-staging.cloud.run",
  "webOrigin": "https://goblog.cloud.run",
  "identity": {
    "audience": "blogpost-staging",
    "idTokenIssuer": "https://securetoken.google.com/blogpost-staging",
    "sessionIssuer": "https://session.firebase.google.com/blogpost-staging"
  },
  "sql": {
    "instanceConnectionName": "blogpost-staging:asia-southeast2:blogpost-db",
    "database": "blogpost",
    "schema": "blogpost"
  },
  "media": {
    "adapter": "gcs",
    "bucket": "blogpost-staging-blogpost-media",
    "projectId": "blogpost-staging"
  },
  "serviceAccounts": {
    "api": "blogpost-api@blogpost-staging.iam.gserviceaccount.com",
    "migrator": "blogpost-migrate@blogpost-staging.iam.gserviceaccount.com",
    "ops": "blogpost-ops@blogpost-staging.iam.gserviceaccount.com",
    "bootstrap": "blogpost-bootstrap@blogpost-staging.iam.gserviceaccount.com"
  },
  "secretVersions": {
    "SQL_APP_PASSWORD": "projects/blogpost-staging/secrets/blogpost-db-app-password/versions/2",
    "SQL_MIGRATOR_PASSWORD": "projects/blogpost-staging/secrets/blogpost-db-migrator-password/versions/2",
    "SQL_ROOT_PASSWORD": "projects/blogpost-staging/secrets/blogpost-db-root-password/versions/2",
    "CURSOR_SIGNING_KEY": "projects/blogpost-staging/secrets/blogpost-cursor-signing-key/versions/2"
  },
  "email": {
    "from": "Blogpost <no-reply@goblogs.app>",
    "dispatchAudience": "https://blogpost-api-zym2bvhhqq-et.a.run.app",
    "dispatchInvoker": "blogpost-scheduler@blogpost-staging.iam.gserviceaccount.com",
    "secretVersions": {
      "RESEND_API_KEY": "projects/blogpost-staging/secrets/blogpost-resend-api-key/versions/1",
      "EMAIL_PAYLOAD_KEY": "projects/blogpost-staging/secrets/blogpost-email-payload-key/versions/1"
    }
  }
}
